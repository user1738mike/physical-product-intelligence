# Local development only. Run python scripts/setup_env.py before starting Compose.
# The script copies this template and generates both credential values in a new .env.
POSTGRES_DB=ppi
POSTGRES_USER=ppi
POSTGRES_PASSWORD=replace-with-local-password
DJANGO_SECRET_KEY=replace-with-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Production additionally requires DJANGO_CSRF_TRUSTED_ORIGINS (HTTPS origins).
# Production secrets must come from a secret manager, never this file.

# Optional AI: disabled by default. Inject OPENAI_API_KEY server-side from secure configuration.
INSTALL_AI_SDK=false
AI_EXTRACTION_ENABLED=false
AI_EXTRACTION_PROVIDER=openai
AI_EXTRACTION_MODEL=
