# Non-secret substitution template; render ONLY outside the repository on the approved host.
PPI_BACKEND_IMAGE=sha256:REPLACE_WITH_VERIFIED_LOADED_IMAGE_ID
PPI_FRONTEND_IMAGE=sha256:REPLACE_WITH_VERIFIED_LOADED_IMAGE_ID
PPI_INGRESS_IMAGE=nginx@sha256:REPLACE_WITH_APPROVED_SCAN_PASSED_DIGEST
PPI_SCANNER_IMAGE=clamav/clamav@sha256:REPLACE_WITH_APPROVED_SCAN_PASSED_DIGEST
PPI_PRODUCTION_ENV_FILE=/etc/ppi/runtime.env
PPI_MIGRATION_ENV_FILE=/etc/ppi/migration.env
PPI_DATABASE_CA_FILE=/etc/ppi/database-ca.crt
PPI_DOMAIN=REPLACE_WITH_APPROVED_DOMAIN
PPI_BIND_ADDRESS=REPLACE_WITH_EXPLICIT_APPROVED_INTERFACE
PPI_SUBNET=REPLACE_WITH_COLLISION_CHECKED_CIDR
PPI_EDGE_IPV4=REPLACE_WITH_RESERVED_INGRESS_IP
PPI_TLS_DIRECTORY=/etc/ppi/tls
PPI_NGINX_CONFIG=/etc/ppi/nginx.conf
PPI_API_BACKEND_ORIGIN=https://REPLACE_WITH_APPROVED_DOMAIN:8443
